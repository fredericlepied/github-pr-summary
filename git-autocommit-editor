#!/usr/bin/env python3

"""Act as an editor for a git commit message.

Extract the diff for the change, format it for a LLM to summarize it for a git commit message."""

import os
from pathlib import PurePosixPath
import subprocess
import sys

import dotenv
import openai


# Generated/lock files that bloat the diff without helping summarize the change.
DEFAULT_EXCLUDES = [
    "uv.lock",
    "poetry.lock",
    "Pipfile.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "composer.lock",
    "go.sum",
    "Gemfile.lock",
]


def exclude_pathspecs():
    """Build git pathspec arguments excluding generated/lock files.

    Override the defaults with a comma-separated AUTOCOMMIT_EXCLUDE env var.
    """
    names = os.getenv("AUTOCOMMIT_EXCLUDE")
    names = names.split(",") if names else DEFAULT_EXCLUDES
    return [f":(exclude,glob)**/{name.strip()}" for name in names if name.strip()]


def commit_scope(paths):
    if len(paths) == 1:
        return PurePosixPath(paths[0]).name

    directories = [str(PurePosixPath(path).parent) for path in paths]
    directory = os.path.commonpath(directories)
    if directory not in ("", "."):
        return directory

    return None


def prefix_subject(message, scope):
    if not scope:
        return message

    lines = message.split("\n")
    if not lines or lines[0].startswith(f"{scope}:"):
        return message

    lines[0] = f"{scope}: {lines[0]}"
    return "\n".join(lines)


def staged_paths():
    result = subprocess.run(
        ["git", "diff", "--staged", "--name-only", "--", *exclude_pathspecs()],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return [line for line in result.stdout.splitlines() if line]


def staged_diff():
    result = subprocess.run(
        ["git", "diff", "--staged", "--", *exclude_pathspecs()],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return result.stdout


def staged_stat():
    result = subprocess.run(
        ["git", "diff", "--staged", "--stat", "--", *exclude_pathspecs()],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return result.stdout


def build_prompt(change):
    return f"""Generate a concise git commit message that summarizes the key changes with a summary line and bullet points starting with `- `. Stay high-level and combine smaller changes to overarching topics. Skip describing any reformatting changes.

Use the following rules:

1. Separate subject from body with a blank line
2. Limit the subject line to 50 characters
3. Capitalize the subject line
4. Do not end the subject line with a period
5. Use the imperative mood in the subject line
6. Wrap the body at 72 characters
7. Use the body to explain what and why vs. how

Code change:\n\n```{change}```\n"""


def complete(client, prompt):
    chat_completion = client.chat.completions.create(
        messages=[
            {
                "role": "user",
                "content": prompt,
            }
        ],
        model=os.getenv("OPENAI_MODEL", "gpt-4o"),
    )
    message = chat_completion.choices[0].message.content.split("\n")
    # remove first line and end line if they are ```
    if message[0] == "```":
        message = message[1:]
    if message[-1] == "```":
        message = message[:-1]
    return "\n".join(message)


def create_commit_message(patch):
    client = openai.OpenAI()

    try:
        return complete(client, build_prompt(patch))
    except openai.BadRequestError as err:
        if "context_length_exceeded" not in str(err):
            raise
        # Diff still too large after excludes: fall back to a stat summary.
        sys.stderr.write("Diff too large, summarizing from --stat instead\n")
        return complete(client, build_prompt(staged_stat()))


if __name__ == "__main__":
    dotenv.load_dotenv()

    data = staged_diff()

    if data == "":
        print("No changes to commit")
        sys.exit(0)

    summary = prefix_subject(create_commit_message(data), commit_scope(staged_paths()))
    sys.stderr.write(f"\n\n{summary}\n")
    with open(sys.argv[1], "w") as f:
        f.write(summary)
